{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_domain",
    "occurrence_id",
    "session_ref",
    "ts_ms",
    "model",
    "usage_form",
    "counts",
    "cumulative",
    "native_credits",
    "vendor_cost",
    "completeness",
    "revision",
    "replaces"
  ],
  "properties": {
    "identity_domain": {
      "enum": [
        "vendor_request",
        "session_call",
        "source_record"
      ]
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799999
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "usage_form": {
      "enum": [
        "per_call",
        "cumulative"
      ]
    },
    "counts": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "cache_creation",
            "cache_read",
            "output",
            "reasoning"
          ],
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_creation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_read": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cumulative": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "series_ref",
            "sample_index",
            "reset_seq",
            "starts_at_zero",
            "reset_evidence_ref"
          ],
          "properties": {
            "series_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "sample_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reset_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "starts_at_zero": {
              "type": "boolean"
            },
            "reset_evidence_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "native_credits": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "amount"
          ],
          "properties": {
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "vendor_cost": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "amount"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "completeness": {
      "enum": [
        "partial",
        "final"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replaces": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenme:review:usage-fact:0.5"
}
