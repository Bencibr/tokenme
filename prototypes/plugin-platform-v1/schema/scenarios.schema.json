{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": "tokenme.reference-scenarios/0.1"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "task", "fixture", "exitCode", "assertions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]{1,48}$"},
        "task": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "fixture": {"type": "string", "maxLength": 128, "pattern": "^fixtures/[A-Za-z0-9_-]+\\.json$"},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 10},
        "exitCode": {"enum": [0, 1]},
        "disabled": {"type": "boolean"}, "denyHttp": {"type": "boolean"},
        "fuel": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "assertions": {"type": "object", "minProperties": 1, "maxProperties": 64, "propertyNames": {"type": "string", "maxLength": 256, "pattern": "^/"}},
        "forbiddenLogText": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "absentEvents": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }}
  }
}
