.DS_Store
apps/tokenme-bar/src-tauri/target
apps/tokenme-bar/src-tauri/gen/schemas

# dev-only: `tokenme report --json` / `tokenme icons --json` output that ?real=1 renders
apps/tokenme-bar/report.json
apps/tokenme-bar/icons.json

# build-macos.sh: hash of everything the test gate compiles; unchanged-since-green skip marker
.cargo-test-stamp

# static musl collector binaries, staged by scripts/bundle-collector.sh
apps/tokenme-bar/src-tauri/resources/collector/

# a compiled CLI binary landed at apps/tokenme-bar/tokenme once and was swept
# into a commit; refuse the exact path — the global apps/ exclusion cannot
# catch it, because the !apps/ rule below re-opens the directory
/apps/tokenme-bar/tokenme

# global gitignore excludes apps/; the panel is product code, keep it here
!apps/

# internal working notes: deleted from history at the 2026-10-09 switch and
# untracked on disk since (docs/internal/PUBLIC_DELIVERY.md, "the one-time switch")
/AGENTS.md
/docs/internal/
/.bugx/
